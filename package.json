{
  "name": "broknowsaspot-wtf",
  "version": "0.1.0",
  "private": true,
  "description": "a crowdsourced guide to hidden, offbeat, adventurous spots",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:contrast && npm run check:borders && npm run format:check",
    "appwrite:provision": "tsx scripts/appwrite-provision.mts",
    "appwrite:seed": "tsx scripts/appwrite-seed.mts",
    "appwrite:verify": "tsx scripts/appwrite-verify.mts",
    "appwrite:setup": "npm run appwrite:provision && npm run appwrite:seed && npm run appwrite:verify",
    "appwrite:admin": "tsx scripts/appwrite-admin.mts",
    "check:borders": "tsx scripts/check-borders.mts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "appwrite": "^26.2.0",
    "framer-motion": "^13.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.4.1",
    "next": "^16.3.1",
    "node-appwrite": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
