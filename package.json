{
  "name": "broknowsaspot-wtf",
  "version": "0.1.0",
  "private": true,
  "description": "a crowdsourced guide to hidden, offbeat, adventurous spots",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
